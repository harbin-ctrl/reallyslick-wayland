all: pixelcity

# Native Wayland build. The old X11 front-end (Win.cpp) and the interim SDL2
# front-end (sdl_main.cpp) are excluded; wl_main.cpp plus the generated
# xdg-shell glue replace them. Render.cpp's windowing-specific code is guarded
# by -DWAYLAND.

WL_PROTO_DIR := $(shell pkg-config --variable=pkgdatadir wayland-protocols)
XDG_SHELL_XML := $(WL_PROTO_DIR)/stable/xdg-shell/xdg-shell.xml
XDG_DECO_XML  := $(WL_PROTO_DIR)/unstable/xdg-decoration/xdg-decoration-unstable-v1.xml

GEN_PROTO_C := xdg-shell-protocol.c xdg-decoration-unstable-v1-protocol.c

# xdg-shell + xdg-decoration client glue, generated by wayland-scanner.
xdg-shell-client-protocol.h:
	wayland-scanner client-header $(XDG_SHELL_XML) $@
xdg-shell-protocol.c:
	wayland-scanner private-code $(XDG_SHELL_XML) $@
xdg-decoration-unstable-v1-client-protocol.h:
	wayland-scanner client-header $(XDG_DECO_XML) $@
xdg-decoration-unstable-v1-protocol.c:
	wayland-scanner private-code $(XDG_DECO_XML) $@

# Everything but the two retired front-ends, plus the generated protocol code.
# fontgen.c is a standalone build tool (its own main), never part of pixelcity.
SRCS := $(filter-out Win.cpp sdl_main.cpp,$(wildcard *.cpp)) \
        $(filter-out $(GEN_PROTO_C) fontgen.c,$(wildcard *.c)) \
        $(GEN_PROTO_C)

DEPS_TMP := $(SRCS:.cpp=.d)
DEPS := $(DEPS_TMP:.c=.d)

OBJS := Building.o Camera.o Car.o Deco.o Entity.o glBbox.o glMatrix.o glQuat.o glRgba.o glVector2.o glVector3.o Ini.o Light.o Math.o Mesh.o Random.o Render.o Sky.o Texture.o Visible.o wl_main.o World.o time_util.o xdg-shell-protocol.o xdg-decoration-unstable-v1-protocol.o gl_ext.o Shader.o font_data.o

# wl_main includes the generated headers, so make sure they exist first.
wl_main.o wl_main.d: xdg-shell-client-protocol.h xdg-decoration-unstable-v1-client-protocol.h

# automatic dependencies: include them all so GNU make will remake them,
-include $(DEPS)

# ...and provide rules to re-make them via gcc/g++
%.d: %.c
	@$(CC) -MM -MP -MF $@ $(CPPFLAGS) $<

%.d: %.cpp
	@$(CXX) -MM -MP -MF $@ $(CPPFLAGS) $<

pixelcity: $(OBJS)
	g++ -o $@ -g $(OBJS) $(LDFLAGS) -lm -lOpenGL -lGLU

WL_CFLAGS := $(shell pkg-config --cflags wayland-client wayland-egl egl xkbcommon)
WL_LIBS   := $(shell pkg-config --libs wayland-client wayland-egl egl xkbcommon)

CFLAGS=-Wall -D_FILE_OFFSET_BITS=64 -DWAYLAND
CXXFLAGS=-Wall -D_FILE_OFFSET_BITS=64 -DWAYLAND
# The runtime no longer uses FreeType/fontconfig -- the glyphs are baked into
# font_data.c by fontgen (see the regen-fonts target). Only fontgen links them.
CPPFLAGS=$(WL_CFLAGS)
LDFLAGS=$(WL_LIBS)

ifeq ($(OPT), 0)
CFLAGS += -g -O0
CXXFLAGS += -g -O0
else
CFLAGS += -O3
CXXFLAGS += -O3
endif

# Build-time font tool: bakes fonts/*.ttf into font_data.c (which is checked in
# and compiled straight into pixelcity). Only needed when the font list or
# FONT_SIZE changes -- a normal build never touches freetype or the .ttf files.
fontgen: fontgen.c font_data.h Texture.h
	g++ -Wall -o $@ fontgen.c $(shell pkg-config --cflags --libs freetype2)

.PHONY: regen-fonts
regen-fonts: fontgen
	./fontgen

clean:
	rm -f *.o pixelcity fontgen

realclean: clean
	rm -f *.d xdg-shell-client-protocol.h xdg-shell-protocol.c \
	      xdg-decoration-unstable-v1-client-protocol.h xdg-decoration-unstable-v1-protocol.c

PREFIX ?= /usr/local
DESTDIR ?=

install: pixelcity
	install -d $(DESTDIR)$(PREFIX)/bin
	install -m 755 pixelcity $(DESTDIR)$(PREFIX)/bin
	install -d $(DESTDIR)$(PREFIX)/share/pixmaps
	install -m 644 pixelcity.png $(DESTDIR)$(PREFIX)/share/pixmaps
	install -d $(DESTDIR)$(PREFIX)/share/applications
	install -m 644 pixelcity.desktop $(DESTDIR)$(PREFIX)/share/applications

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/pixelcity
	rm -f $(DESTDIR)$(PREFIX)/share/pixmaps/pixelcity.png
	rm -f $(DESTDIR)$(PREFIX)/share/applications/pixelcity.desktop

install-user: pixelcity
	install -d $(HOME)/.local/bin
	install -m 755 pixelcity $(HOME)/.local/bin
	install -d $(HOME)/.local/share/pixmaps
	install -m 644 pixelcity.png $(HOME)/.local/share/pixmaps
	install -d $(HOME)/.local/share/applications
	install -m 644 pixelcity.desktop $(HOME)/.local/share/applications

uninstall-user:
	rm -f $(HOME)/.local/bin/pixelcity
	rm -f $(HOME)/.local/share/pixmaps/pixelcity.png
	rm -f $(HOME)/.local/share/applications/pixelcity.desktop

