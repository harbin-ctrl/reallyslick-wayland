# Generated by wayland-scanner from the protocol XML at build time. The exact filenames vary between
# screensavers - some use xdg-shell-protocol.c, others xdg-shell-client-protocol.c - so match the family.
xdg-*-protocol.c
xdg-*-protocol.h
xdg-*-client-protocol.c
xdg-*-client-protocol.h

*.o
*.bak

# Built binaries - one per screensaver, named after its directory
colorfire
flurry
flux
lattice
pixelcity
skyrocket
solarwinds
substrate
